  "claude-code": {
    "name": "Claude Code (subscription)",
    "package": "@opencode/ai/providers/openai-compatible",
    "settings": {
      "baseURL": "http://127.0.0.1:8787/v1",
      "apiKey": "claude-code-proxy"
